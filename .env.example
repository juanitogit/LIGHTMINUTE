DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
LLM_PROVIDER=deepseek        # deepseek | none  (none = template cards only)
MISSION_PROFILE=mars         # iss | moon | mars  (controls light-delay simulation)

# Backend only. Never use a VITE_ prefix or commit the real credential.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require

# Google OAuth: server-only, shared by Vite and Cloudflare Pages Functions.
GOOGLE_CLIENT_ID=619189845956-tsk1tlbi1407drld4fl2j8djr1kebgu3.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
# Generate a random value of at least 32 characters; use the same value across instances.
AUTH_SESSION_SECRET=
