[TEMPLATE]
# Default explanation provider: Groq (OpenAI-compatible, open-weight models).
LLM_PROVIDER=groq            # groq | deepseek | none  (none = template cards only)
GROQ_API_KEY=gsk_...
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Alternative provider, same code path (only if you have a DeepSeek key).
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash

MISSION_PROFILE=mars         # iss | moon | mars  (controls light-delay simulation)
