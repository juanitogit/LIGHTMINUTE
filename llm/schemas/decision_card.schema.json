{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DecisionCard",
  "type": "object",
  "additionalProperties": false,
  "required": ["level","headline","what_changed","why_it_matters","confidence","do_now","monitor","escalate_if","ground_message","citations"],
  "properties": {
    "level": {"enum": ["info","watch","act","escalate"]},
    "headline": {"type": "string", "maxLength": 100},
    "what_changed": {"type": "string", "maxLength": 300},
    "why_it_matters": {"type": "string", "maxLength": 400},
    "confidence": {"enum": ["low","moderate","high"]},
    "do_now": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string", "maxLength": 120}},
    "monitor": {"type": "array", "items": {"type": "string"}},
    "escalate_if": {"type": "array", "items": {"type": "string"}},
    "ground_message": {"type": "string", "maxLength": 140},
    "citations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
