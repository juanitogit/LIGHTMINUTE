{
  "name": "@lightminute/crew-tablet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LIGHTMINUTE crew tablet: Glance -> Why -> Act. Synthetic data only; not a medical device.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test:e2e": "node scripts/smoke.mjs",
    "test:e2e:browser": "node tests/e2e.mjs",
    "test:auth": "tsx --test server/google.test.ts",
    "cf:deploy": "npm run build && wrangler pages deploy dist --project-name lightminute --branch main"
  },
  "dependencies": {
    "jose": "^6.2.17",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "wrangler": "^4.162.0"
  }
}
