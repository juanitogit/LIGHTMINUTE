{
  "name": "@lightminute/crew-tablet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LIGHTMINUTE crew tablet: Glance -> Why -> Act. Synthetic data only; not a medical device.",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:static && npm run typecheck:static && node scripts/check-signatures.mjs && tsc -b && vite build",
    "build:static": "tsx scripts/build-static.ts",
    "typecheck:static": "tsc -p tsconfig.static.json && tsc -p tsconfig.e2e.json",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test:e2e": "node scripts/smoke.mjs",
    "test:e2e:browser": "node tests/e2e.mjs",
    "test:physiology": "tsx src/physiology/__tests__/physiology.test.ts",
    "cf:deploy": "npm run build && wrangler pages deploy dist --project-name lightminute --branch main"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@huggingface/transformers": "^3.8.1",
    "pyodide": "314.0.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "wrangler": "^4.162.0"
  }
}
